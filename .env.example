# GitHub CI/CD Engine - Environment Configuration

# Server Port (default: 3000)
PORT=3000

# GitHub Webhook Security
# Shared secret configured in GitHub repository Settings -> Webhooks.
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret

# GitHub Commit Status Reporting
# Fine-grained Personal Access Token (PAT) with "Commit statuses: Read and write" permission.
GITHUB_TOKEN=replace_with_your_fine_grained_token

# Live Integration Base URL (Optional)
DAY7_LIVE_BASE_URL=http://127.0.0.1:3000

# Public Tunnel Base URL (Optional)
# If using ngrok or a public reverse proxy for live GitHub webhooks:
# PUBLIC_WEBHOOK_BASE_URL=https://your-tunnel-id.ngrok-free.app

# Management API Secret (Optional)
# Leave empty for local-only development mode (loopback restricted).
# If set, all management endpoints require the header `x-management-token: <secret>`.
# MANAGEMENT_SECRET=replace_with_a_secure_management_secret
