
# CI/CD Server
# Change this if your server uses another port.
PORT=4000

# GitHub Webhook Security
# Use the same secret configured in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret

# GitHub Commit Status Reporting
# Fine-grained token with Commit statuses: Read and write.
GITHUB_TOKEN=replace_with_your_fine_grained_token

# Live Integration Test
# The local URL is sufficient if the server runs on this machine.
DAY7_LIVE_BASE_URL=http://127.0.0.1:4000

# Optional — used only when testing against a mock GitHub API.
# GITHUB_API_BASE_URL=http://127.0.0.1:9999
