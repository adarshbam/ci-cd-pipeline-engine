{
  "$schema": "./schema/workflow.schema.json",
  "name": "day7-github",
  "version": "1.0",
  "webhook": {
    "url": "/webhooks/day7-github",
    "methods": ["POST"]
  },
  "trigger": {
    "events": ["push"],
    "allowedBranches": ["main"],
    "allowedRepositories": ["example/day7-project"]
  },
  "jobs": {
    "build": {
      "steps": [
        {
          "name": "GitHub Build",
          "run": "echo 'Building GitHub project'"
        }
      ]
    },
    "test": {
      "needs": ["build"],
      "steps": [
        {
          "name": "GitHub Tests",
          "run": "echo 'All GitHub tests passed'"
        }
      ]
    }
  }
}
