{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/Workflow.schema.json",
  "title": "CI/CD Workflow Schema",
  "description": "Production-grade, generalized workflow configuration schema for the custom CI/CD Pipeline Engine. This schema is shared by every workflow and is not tied to a specific project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "name", "trigger", "jobs"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema URI or relative path used by the workflow configuration.",
      "examples": ["./Workflow.schema.json"]
    },
    "version": {
      "type": "string",
      "description": "Workflow configuration schema version understood by the pipeline engine.",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
      "examples": ["1.0", "1.1"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable unique workflow name.",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9 ._-]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "webhook": {
      "$ref": "#/$defs/webhook"
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "concurrency": {
      "$ref": "#/$defs/concurrency"
    },
    "defaults": {
      "$ref": "#/$defs/workflowDefaults"
    },
    "variables": {
      "$ref": "#/$defs/keyValueMap"
    },
    "secrets": {
      "$ref": "#/$defs/secretMap"
    },
    "runners": {
      "type": "object",
      "description": "Optional workflow-level runner requirements. Job-level runner settings can override these defaults.",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "examples": [["linux", "x64", "node-24"]]
        },
        "pool": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["shared", "dedicated", "ephemeral"]
        },
        "maxQueueTime": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "environments": {
      "type": "object",
      "description": "Named execution/deployment environments shared by jobs in this workflow.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/environment"
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifactDefaults"
    },
    "cache": {
      "$ref": "#/$defs/cacheDefaults"
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "notifications": {
      "$ref": "#/$defs/notifications"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "jobs": {
      "$ref": "#/$defs/jobs"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?)(?:ms|s|m|h|d)$",
      "examples": ["30s", "10m", "1h"]
    },
    "cron": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "description": "Engine expression. Runtime placeholders such as ${branch}, ${environment}, ${commit.sha}, ${run.id}, and ${HEALTH_URL} are supported by the engine."
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "keyValueMap": {
      "type": "object",
      "description": "String-based key/value variables available to the workflow.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "secretMap": {
      "type": "object",
      "description": "Secrets referenced by name. Secret values should be injected by the engine/secret provider, not committed to workflow files.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "name"],
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["engine", "env", "vault", "secret-manager", "external"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\s]*$",
          "description": "Path handled by the custom CI/CD server webhook router."
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["POST"]
          },
          "default": ["POST"]
        },
        "secretRef": {
          "$ref": "#/$defs/identifier"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": ["HMAC-SHA256", "HMAC-SHA512"]
            },
            "header": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "required": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "description": "Events supported by the custom webhook/trigger subsystem.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "push",
              "pull_request",
              "manual",
              "schedule",
              "tag",
              "release"
            ]
          }
        },
        "branches": {
          "type": "object",
          "description": "Maps source branches to target environments. A branch may be mapped to a named environment such as test/prod.",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          },
          "examples": [{ "develop": "test", "main": "prod" }]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "$ref": "#/$defs/pathFilters"
        },
        "pullRequest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "opened",
                  "synchronize",
                  "reopened",
                  "closed",
                  "merged"
                ]
              }
            },
            "branches": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cron"],
            "properties": {
              "cron": {
                "$ref": "#/$defs/cron"
              },
              "timezone": {
                "$ref": "#/$defs/nonEmptyString",
                "default": "UTC"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "events": {
                "contains": { "const": "schedule" }
              }
            }
          },
          "then": {
            "required": ["schedule"]
          }
        },
        {
          "if": {
            "properties": {
              "events": {
                "contains": { "const": "pull_request" }
              }
            }
          },
          "then": {
            "required": ["pullRequest"]
          }
        }
      ]
    },
    "pathFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "group"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "group": {
          "$ref": "#/$defs/expression",
          "description": "Concurrency key. Supports expressions such as ${branch}, ${environment}, and ${project}."
        },
        "cancelInProgress": {
          "type": "boolean",
          "default": false
        },
        "queueLimit": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "cancelReason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "workflowDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shell": {
          "type": "string",
          "enum": ["bash", "sh", "pwsh", "powershell", "cmd"]
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "continueOnError": {
          "type": "boolean",
          "default": false
        },
        "env": {
          "$ref": "#/$defs/keyValueMap"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envFile": {
          "type": "string",
          "minLength": 1
        },
        "healthUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "variables": {
          "$ref": "#/$defs/keyValueMap"
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "protection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requiredApprovals": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "approvers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "waitTimer": {
              "$ref": "#/$defs/duration"
            }
          }
        }
      }
    },
    "artifactDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "zip", "tar-gz"]
        },
        "storage": {
          "type": "string",
          "enum": ["local", "object-storage"]
        },
        "failOnMissing": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "cacheDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "provider": {
          "type": "string",
          "enum": ["local", "redis", "object-storage"]
        },
        "keyPrefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "restoreKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryRead": {
          "type": "boolean",
          "default": true
        },
        "repositoryWrite": {
          "type": "boolean",
          "default": false
        },
        "deployment": {
          "type": "boolean",
          "default": false
        },
        "artifactsRead": {
          "type": "boolean",
          "default": true
        },
        "artifactsWrite": {
          "type": "boolean",
          "default": true
        },
        "secretsRead": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failFast": {
          "type": "boolean",
          "default": true
        },
        "allowEmptyJobs": {
          "type": "boolean",
          "default": false
        },
        "requireArtifactsForDeploy": {
          "type": "boolean",
          "default": false
        },
        "requireHealthCheckForDeploy": {
          "type": "boolean",
          "default": false
        },
        "maxParallelJobs": {
          "type": "integer",
          "minimum": 1
        },
        "maxRetriesPerStep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "jobs": {
      "type": "object",
      "description": "DAG nodes of the workflow. Each property name is a job identifier and each needs list creates a dependency edge.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/job"
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "if": {
          "$ref": "#/$defs/expression"
        },
        "environment": {
          "$ref": "#/$defs/expression"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "strategy": {
          "$ref": "#/$defs/strategy"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "continueOnError": {
          "type": "boolean",
          "default": false
        },
        "env": {
          "$ref": "#/$defs/keyValueMap"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "artifacts": {
          "$ref": "#/$defs/jobArtifacts"
        },
        "cache": {
          "$ref": "#/$defs/jobCache"
        },
        "outputs": {
          "$ref": "#/$defs/outputMap"
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pool": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "mode": {
          "type": "string",
          "enum": ["shared", "dedicated", "ephemeral"]
        },
        "workspace": {
          "type": "string",
          "enum": ["clean", "persistent"]
        },
        "shell": {
          "type": "string",
          "enum": ["bash", "sh", "pwsh", "powershell", "cmd"]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "memoryMb": {
              "type": "integer",
              "minimum": 1
            },
            "diskMb": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "maxQueueTime": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {}
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "maxParallel": {
          "type": "integer",
          "minimum": 1
        },
        "failFast": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "image": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "env": {
          "$ref": "#/$defs/keyValueMap"
        },
        "healthCheck": {
          "$ref": "#/$defs/healthCheck"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "if": {
          "$ref": "#/$defs/expression"
        },
        "run": {
          "$ref": "#/$defs/command"
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "Relative executable script path in the repository, for example scripts/deploy.sh."
        },
        "uses": {
          "type": "string",
          "minLength": 1,
          "description": "Engine-supported reusable action/task identifier. This is a custom engine abstraction, not GitHub Actions syntax."
        },
        "args": {
          "type": "array",
          "items": {}
        },
        "with": {
          "type": "object",
          "additionalProperties": true
        },
        "env": {
          "$ref": "#/$defs/keyValueMap"
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "string",
          "enum": ["bash", "sh", "pwsh", "powershell", "cmd"]
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "continueOnError": {
          "type": "boolean",
          "default": false
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        },
        "artifacts": {
          "$ref": "#/$defs/stepArtifacts"
        },
        "cache": {
          "$ref": "#/$defs/stepCache"
        }
      },
      "oneOf": [
        {
          "required": ["run"],
          "not": {
            "anyOf": [{ "required": ["script"] }, { "required": ["uses"] }]
          }
        },
        {
          "required": ["script"],
          "not": {
            "anyOf": [{ "required": ["run"] }, { "required": ["uses"] }]
          }
        },
        {
          "required": ["uses"],
          "not": {
            "anyOf": [{ "required": ["run"] }, { "required": ["script"] }]
          }
        }
      ]
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "backoff": {
          "type": "string",
          "enum": ["fixed", "exponential"]
        },
        "delay": {
          "$ref": "#/$defs/duration"
        },
        "retryOnExitCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "interval": {
          "$ref": "#/$defs/duration"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "oneOf": [
        { "required": ["url"], "not": { "required": ["command"] } },
        { "required": ["command"], "not": { "required": ["url"] } }
      ]
    },
    "outputMap": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "jobArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "download": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactReference"
          }
        }
      }
    },
    "stepArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "zip", "tar-gz"]
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fromJob": {
          "$ref": "#/$defs/identifier"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "jobCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restore": {
          "type": "array",
          "items": { "$ref": "#/$defs/cacheEntry" }
        },
        "save": {
          "type": "array",
          "items": { "$ref": "#/$defs/cacheEntry" }
        }
      }
    },
    "stepCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restore": {
          "$ref": "#/$defs/cacheEntry"
        },
        "save": {
          "$ref": "#/$defs/cacheEntry"
        }
      }
    },
    "cacheEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "paths"],
      "properties": {
        "key": {
          "$ref": "#/$defs/expression"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "restoreKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "failOnMiss": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onFailure": { "$ref": "#/$defs/notificationRule" },
        "onSuccess": { "$ref": "#/$defs/notificationRule" },
        "onCancellation": { "$ref": "#/$defs/notificationRule" },
        "onManualApproval": { "$ref": "#/$defs/notificationRule" }
      }
    },
    "notificationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["console", "webhook", "email", "slack"]
          }
        },
        "webhookUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
