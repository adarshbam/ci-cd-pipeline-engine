{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",

  "properties": {
    "deployment": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "runScript": {
          "type": "string"
        }
      },
      "required": ["environment", "runScript"]
    },

    "event": {
      "type": "object",
      "properties": {
        "push": {
          "type": "boolean"
        }
      },
      "required": ["push"]
    },

    "notifications": {
      "type": "object",
      "properties": {
        "notifyOnFailure": {
          "type": "boolean"
        },
        "failureMessage": {
          "type": "string"
        }
      },
      "required": ["notifyOnFailure", "failureMessage"]
    }
  },

  "required": ["deployment", "event", "notifications"]
}
