{
  "$schema": "./project-2.schema.json",

  "webhook": {
    "url": "/github/rollback"
  },

  "deployment": {
    "environment": "staging",
    "runScript": "scripts/rollback.sh"
  },

  "event": {
    "push": true
  },

  "notifications": {
